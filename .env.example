# The app reads configuration ONLY from environment variables. run.sh sources
# this file into the environment before starting the server — that is how
# secrets reach the app. If you start the server without run.sh, export these
# yourself.

# ---- Model provider ---------------------------------------------------------
# blackjet speaks exactly one protocol: the OpenAI Chat Completions API
# (POST <base>/v1/chat/completions). Every provider below serves it, so there
# is one request builder and one response parser rather than a branch per
# vendor. Ollama is the default: local, keyless, nothing leaves the box.

# Preset name. Local + keyless: ollama (default), vllm, llamacpp, lmstudio.
# Hosted + keyed: openai, groq, together, openrouter. Any other name is a
# generic OpenAI-compatible endpoint and requires AI_PROVIDER_URL below.
#AI_PROVIDER=ollama

# Endpoint URL, overriding the preset. A bare host, an OpenAI base (.../v1) or
# the full .../v1/chat/completions path all work — the missing suffix is
# appended, so you cannot end up with /v1/v1/. A ?token=... query parameter,
# if your remote instance uses one, is preserved, promoted to a Bearer header,
# and its value is redacted from all logs. Examples:
#   AI_PROVIDER_URL=http://127.0.0.1:11434/v1             local ollama (default)
#   AI_PROVIDER_URL=http://10.0.0.5:11434?token=xxxx      rented GPU w/ token
#   AI_PROVIDER_URL=https://api.groq.com/openai/v1        hosted
#AI_PROVIDER_URL=

# Bearer token. Not needed by the local presets; required by the hosted ones.
# Sent as Authorization: Bearer. Never logged.
AI_PROVIDER_APIKEY=

# Model id / tag, overriding the preset default. e.g. mistral:7b (ollama
# default), qwen2.5:32b, llama3.1:8b, gpt-4o-mini, llama-3.1-8b-instant
#AI_PROVIDER_MODEL=

# Legacy names still honored as fallbacks, so existing .env files keep working:
#   HOSTED_OLLAMA_URL, OLLAMA_URL, OLLAMA_HOST/OLLAMA_PORT,
#   HOSTED_OLLAMA_AUTH_TOKEN, OLLAMA_MODEL

# ---- Optional overrides (defaults shown) ------------------------------------
#BLACKJET_HOST=127.0.0.1
#BLACKJET_PORT=8080
#BLACKJET_LOG_LEVEL=INFO          # DEBUG shows more blackjet.* detail in the log pane
#BLACKJET_DEBUG_THIRD_PARTY=0     # 1 = let presidio/spacy flood DEBUG too
#BLACKJET_USE_NER=1
#BLACKJET_SPACY_MODEL=en_core_web_lg   # or en_core_web_sm on constrained hardware
#BLACKJET_MAX_TOKENS=4096
#BLACKJET_MODEL_TIMEOUT=120       # default 600 for a local provider, 120 hosted
